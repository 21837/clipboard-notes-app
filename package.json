{
  "name": "clipboard-notes-app",
  "version": "1.0.0",
  "description": "功能笔记 - 剪切板监测与笔记编辑",
  "main": "main.js",
  "scripts": {
    "start": "start /B electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "keywords": [
    "clipboard",
    "notes",
    "productivity",
    "tool"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "canvas": "^3.2.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "build": {
    "appId": "com.clipboard.notes.app",
    "productName": "功能笔记",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "dify.js",
      "dify-config.json",
      "src/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      "assets/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
